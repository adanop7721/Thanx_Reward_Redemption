# Thanx Rewards System - Main .gitignore

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE and Editor Files
.vscode/
.idea/
*.swp
*.swo
*~

# Log files
*.log
logs/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Temporary files
tmp/
temp/

# Archives
*.zip
*.tar.gz
*.rar

# Database
*.sqlite3
*.db

# Coverage reports
coverage/
*.lcov

# Dependency directories
node_modules/
vendor/bundle/

# Build outputs
dist/
build/
public/packs/
public/assets/

# Rails specific
backend/log/*
backend/tmp/*
backend/storage/*
backend/config/master.key
backend/config/credentials.yml.enc

# Frontend specific
frontend/dist/
frontend/build/
frontend/node_modules/
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
